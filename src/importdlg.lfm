object ImportForm: TImportForm
  Left = 400
  Height = 250
  Top = 250
  Width = 520
  BorderStyle = bsDialog
  Caption = 'Import'
  ClientHeight = 250
  ClientWidth = 520
  OnCreate = FormCreate
  Position = poOwnerFormCenter
  object lblFormat: TLabel
    Left = 12
    Height = 15
    Top = 16
    Width = 40
    Caption = 'Format'
  end
  object cbFormat: TComboBox
    Left = 80
    Height = 23
    Top = 12
    Width = 260
    ItemHeight = 15
    Style = csDropDownList
    TabOrder = 0
    OnChange = cbFormatChange
  end
  object lblFile: TLabel
    Left = 12
    Height = 15
    Top = 50
    Width = 20
    Caption = 'File'
  end
  object edFile: TEdit
    Left = 80
    Height = 23
    Top = 46
    Width = 340
    TabOrder = 1
  end
  object btnBrowse: TButton
    Left = 428
    Height = 25
    Top = 45
    Width = 80
    Caption = 'Browse...'
    TabOrder = 2
    OnClick = btnBrowseClick
  end
  object rgPosition: TRadioGroup
    Left = 12
    Height = 76
    Top = 82
    Width = 260
    AutoFill = True
    Caption = 'Position'
    ChildSizing.LeftRightSpacing = 6
    ChildSizing.EnlargeHorizontal = crsHomogenousChildResize
    ChildSizing.EnlargeVertical = crsHomogenousChildResize
    ChildSizing.ShrinkHorizontal = crsScaleChilds
    ChildSizing.ShrinkVertical = crsScaleChilds
    ChildSizing.Layout = cclLeftToRightThenTopToBottom
    ChildSizing.ControlsPerLine = 1
    ItemIndex = 0
    Items.Strings = (
      'At the address in the file'
      'At offset (hex)'
    )
    TabOrder = 3
    OnClick = rgPositionClick
  end
  object edOffset: TEdit
    Left = 284
    Height = 23
    Top = 124
    Width = 90
    TabOrder = 4
    Text = '00000'
  end
  object lblInfo: TLabel
    Left = 12
    Height = 36
    Top = 168
    Width = 496
    AutoSize = False
    Caption = 'Only the bytes in the file are written, the rest of the buffer stays intact.'
    WordWrap = True
  end
  object btnOK: TButton
    Left = 340
    Height = 25
    Top = 214
    Width = 80
    Caption = 'OK'
    Default = True
    TabOrder = 5
    OnClick = btnOKClick
  end
  object btnCancel: TButton
    Left = 428
    Height = 25
    Top = 214
    Width = 80
    Cancel = True
    Caption = 'Cancel'
    ModalResult = 2
    TabOrder = 6
  end
  object OpenDialog1: TOpenDialog
    Title = 'Import file'
    Options = [ofFileMustExist, ofEnableSizing, ofViewDetail]
    Left = 460
    Top = 100
  end
end
